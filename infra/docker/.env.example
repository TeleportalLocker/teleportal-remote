# Copier vers .env à côté de compose.yml si besoin.
# docker compose --env-file .env up

# Relay
TELEPORTAL_SESSION_TTL_SECS=600
TELEPORTAL_RATE_LIMIT_PER_MIN=30

# Caddy — laisser TELEPORTAL_DOMAIN vide pour HTTP local :8080
TELEPORTAL_HTTP_PORT=8080
TELEPORTAL_HTTPS_PORT=443
TELEPORTAL_DOMAIN=
TELEPORTAL_ACME_EMAIL=

# Client desktop (hors compose) :
# TELEPORTAL_RELAY_URL=ws://127.0.0.1:8080/ws
# TELEPORTAL_RELAY_URL=wss://relay.example.com/ws
